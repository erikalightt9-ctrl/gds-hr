{
  "name": "gds-hr",
  "version": "1.0.0",
  "private": true,
  "description": "GDS CAPITAL INC. HR 201 File & Employee Management, attendance, leave and payroll",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "node src/server.mjs",
    "start": "node src/server.mjs",
    "preview": "node scripts/preview-roster.mjs",
    "test": "node --test tests/*.test.mjs",
    "coverage": "node --experimental-test-coverage --test-coverage-include=src/*.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "backup": "node scripts/backup-r2.mjs run",
    "backup:setup": "node scripts/backup-r2.mjs setup",
    "backup:status": "node scripts/backup-r2.mjs status",
    "backup:restore": "node scripts/backup-r2.mjs restore"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
